{
  "$schema": "https://ferrflow.com/schema/ferrflow.json",
  "workspace": {
    "versioning": "calver-short-seq",
    "tagTemplate": "{name}@v{version}",
    "recoverMissedReleases": true,
    "updateLockfiles": true
  },
  "package": [
    {
      "name": "plugin-api",
      "path": "crates/plugin-api",
      "changelog": "crates/plugin-api/CHANGELOG.md",
      "versionedFiles": [
        {
          "path": "crates/plugin-api/Cargo.toml",
          "format": "toml"
        },
        {
          "path": "Cargo.toml",
          "format": "txt",
          "selector": "(?m)^idlewarden-plugin\\-api\\s*=\\s*\\{[^}]*version = \"(.+?)\""
        }
      ],
      "floatingTags": [
        "major",
        "minor"
      ],
      "publishers": [
        {
          "kind": "cargo"
        }
      ]
    },
    {
      "name": "capture",
      "path": "crates/capture",
      "dependsOn": [
        "plugin-api"
      ],
      "changelog": "crates/capture/CHANGELOG.md",
      "versionedFiles": [
        {
          "path": "crates/capture/Cargo.toml",
          "format": "toml"
        },
        {
          "path": "Cargo.toml",
          "format": "txt",
          "selector": "(?m)^idlewarden-capture\\s*=\\s*\\{[^}]*version = \"(.+?)\""
        }
      ],
      "publishers": [
        {
          "kind": "cargo"
        }
      ]
    },
    {
      "name": "vision",
      "path": "crates/vision",
      "dependsOn": [
        "plugin-api",
        "capture"
      ],
      "changelog": "crates/vision/CHANGELOG.md",
      "versionedFiles": [
        {
          "path": "crates/vision/Cargo.toml",
          "format": "toml"
        },
        {
          "path": "Cargo.toml",
          "format": "txt",
          "selector": "(?m)^idlewarden-vision\\s*=\\s*\\{[^}]*version = \"(.+?)\""
        }
      ],
      "publishers": [
        {
          "kind": "cargo"
        }
      ]
    },
    {
      "name": "input",
      "path": "crates/input",
      "dependsOn": [
        "plugin-api"
      ],
      "changelog": "crates/input/CHANGELOG.md",
      "versionedFiles": [
        {
          "path": "crates/input/Cargo.toml",
          "format": "toml"
        },
        {
          "path": "Cargo.toml",
          "format": "txt",
          "selector": "(?m)^idlewarden-input\\s*=\\s*\\{[^}]*version = \"(.+?)\""
        }
      ],
      "publishers": [
        {
          "kind": "cargo"
        }
      ]
    },
    {
      "name": "bridge",
      "path": "crates/bridge",
      "dependsOn": [
        "plugin-api"
      ],
      "changelog": "crates/bridge/CHANGELOG.md",
      "versionedFiles": [
        {
          "path": "crates/bridge/Cargo.toml",
          "format": "toml"
        },
        {
          "path": "Cargo.toml",
          "format": "txt",
          "selector": "(?m)^idlewarden-bridge\\s*=\\s*\\{[^}]*version = \"(.+?)\""
        }
      ],
      "publishers": [
        {
          "kind": "cargo"
        }
      ]
    },
    {
      "name": "mod-install",
      "path": "crates/mod-install",
      "dependsOn": [
        "plugin-api"
      ],
      "changelog": "crates/mod-install/CHANGELOG.md",
      "versionedFiles": [
        {
          "path": "crates/mod-install/Cargo.toml",
          "format": "toml"
        },
        {
          "path": "Cargo.toml",
          "format": "txt",
          "selector": "(?m)^idlewarden-mod\\-install\\s*=\\s*\\{[^}]*version = \"(.+?)\""
        }
      ],
      "publishers": [
        {
          "kind": "cargo"
        }
      ]
    },
    {
      "name": "plugin-host",
      "path": "crates/plugin-host",
      "dependsOn": [
        "plugin-api"
      ],
      "changelog": "crates/plugin-host/CHANGELOG.md",
      "versionedFiles": [
        {
          "path": "crates/plugin-host/Cargo.toml",
          "format": "toml"
        },
        {
          "path": "Cargo.toml",
          "format": "txt",
          "selector": "(?m)^idlewarden-plugin\\-host\\s*=\\s*\\{[^}]*version = \"(.+?)\""
        }
      ],
      "publishers": [
        {
          "kind": "cargo"
        }
      ]
    },
    {
      "name": "agent",
      "path": "crates/agent",
      "dependsOn": [
        "plugin-api"
      ],
      "changelog": "crates/agent/CHANGELOG.md",
      "versionedFiles": [
        {
          "path": "crates/agent/Cargo.toml",
          "format": "toml"
        },
        {
          "path": "Cargo.toml",
          "format": "txt",
          "selector": "(?m)^idlewarden-agent\\s*=\\s*\\{[^}]*version = \"(.+?)\""
        }
      ],
      "publishers": [
        {
          "kind": "cargo"
        }
      ]
    },
    {
      "name": "core",
      "path": "crates/core",
      "dependsOn": [
        "plugin-api",
        "capture",
        "vision",
        "input",
        "bridge",
        "plugin-host",
        "agent"
      ],
      "changelog": "crates/core/CHANGELOG.md",
      "versionedFiles": [
        {
          "path": "crates/core/Cargo.toml",
          "format": "toml"
        },
        {
          "path": "Cargo.toml",
          "format": "txt",
          "selector": "(?m)^idlewarden-core\\s*=\\s*\\{[^}]*version = \"(.+?)\""
        }
      ],
      "publishers": [
        {
          "kind": "cargo"
        }
      ]
    },
    {
      "name": "desktop",
      "path": "apps/desktop",
      "dependsOn": [
        "core",
        "capture",
        "vision",
        "input",
        "bridge",
        "mod-install",
        "plugin-api"
      ],
      "changelog": "apps/desktop/CHANGELOG.md",
      "versionedFiles": [
        {
          "path": "apps/desktop/src-tauri/Cargo.toml",
          "format": "toml"
        },
        {
          "path": "apps/desktop/src-tauri/tauri.conf.json",
          "format": "json"
        }
      ]
    },
    {
      "name": "mod-bridge",
      "path": "mods/src/IdleWarden.Bridge",
      "tagTemplate": "mod/bridge@v{version}",
      "changelog": "mods/src/IdleWarden.Bridge/CHANGELOG.md",
      "versionedFiles": [
        {
          "path": "mods/src/IdleWarden.Bridge/IdleWarden.Bridge.csproj",
          "format": "csproj"
        }
      ]
    },
    {
      "name": "mod-reference",
      "path": "mods/src/IdleWarden.Reference",
      "dependsOn": [
        "mod-bridge"
      ],
      "tagTemplate": "mod/reference@v{version}",
      "changelog": "mods/src/IdleWarden.Reference/CHANGELOG.md",
      "versionedFiles": [
        {
          "path": "mods/src/IdleWarden.Reference/IdleWarden.Reference.csproj",
          "format": "csproj"
        }
      ]
    },
    {
      "name": "mod-cookie-clicker",
      "path": "mods/js",
      "tagTemplate": "mod/cookie-clicker@v{version}",
      "changelog": "mods/js/CHANGELOG.md"
    },
    {
      "name": "plugin-example-game",
      "path": "plugins/example-game",
      "tagTemplate": "plugin/example-game@v{version}",
      "changelog": "plugins/example-game/CHANGELOG.md",
      "versionedFiles": [
        {
          "path": "plugins/example-game/plugin.json",
          "format": "json"
        }
      ]
    },
    {
      "name": "plugin-cookie-clicker",
      "path": "plugins/cookie-clicker",
      "tagTemplate": "plugin/cookie-clicker@v{version}",
      "changelog": "plugins/cookie-clicker/CHANGELOG.md",
      "versionedFiles": [
        {
          "path": "plugins/cookie-clicker/plugin.json",
          "format": "json"
        }
      ]
    },
    {
      "name": "mod-kale-decisions",
      "path": "mods/src/IdleWarden.Kale.Decisions",
      "dependsOn": [
        "mod-bridge"
      ],
      "tagTemplate": "mod/kale-decisions@v{version}",
      "changelog": "mods/src/IdleWarden.Kale.Decisions/CHANGELOG.md",
      "versionedFiles": [
        {
          "path": "mods/src/IdleWarden.Kale.Decisions/IdleWarden.Kale.Decisions.csproj",
          "format": "csproj"
        }
      ]
    },
    {
      "name": "mod-kale",
      "path": "mods/src/IdleWarden.Kale",
      "dependsOn": [
        "mod-bridge",
        "mod-kale-decisions"
      ],
      "tagTemplate": "mod/kale@v{version}",
      "changelog": "mods/src/IdleWarden.Kale/CHANGELOG.md",
      "versionedFiles": [
        {
          "path": "mods/src/IdleWarden.Kale/IdleWarden.Kale.csproj",
          "format": "csproj"
        }
      ]
    },
    {
      "name": "plugin-master-healer-kale",
      "path": "plugins/master-healer-kale",
      "tagTemplate": "plugin/master-healer-kale@v{version}",
      "changelog": "plugins/master-healer-kale/CHANGELOG.md",
      "versionedFiles": [
        {
          "path": "plugins/master-healer-kale/plugin.json",
          "format": "json"
        }
      ]
    }
  ]
}
