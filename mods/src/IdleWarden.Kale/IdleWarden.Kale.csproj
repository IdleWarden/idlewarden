<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The game's own assemblies target netstandard2.1, and referencing them
         from a 2.0 project fails to compile. Everything else here is 2.0, which
         a 2.1 project consumes without trouble. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <Version>26.9.2</Version>
    <Product>IdleWarden Master Healer Kale bridge</Product>
    <LangVersion>latest</LangVersion>
    <AssemblyName>IdleWarden.Kale</AssemblyName>
    <RootNamespace>IdleWarden.Kale</RootNamespace>
    <Description>BepInEx mod exposing Master Healer Kale over the IdleWarden bridge.</Description>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Two ways to build the same source.
       Without arguments it compiles against IdleWarden.Kale.GameStubs, which
       declares the game's signatures and nothing else, so CI can build and
       release this mod on a machine that does not own the game.
       With `-p:KaleGameDir=...` it compiles against the installed game instead.
       That second mode is the only thing that catches a stub having drifted from
       what the game now looks like, so it is worth running before a release. -->
  <PropertyGroup>
    <KaleManagedDir Condition="'$(KaleGameDir)' != ''">$(KaleGameDir)\MasterHealerKale_Data\Managed</KaleManagedDir>
    <UseInstalledGame>false</UseInstalledGame>
    <UseInstalledGame Condition="'$(KaleGameDir)' != ''">true</UseInstalledGame>
  </PropertyGroup>

  <Target Name="SayWhereTheGameIs" BeforeTargets="ResolveAssemblyReferences" Condition="'$(UseInstalledGame)' == 'true'">
    <Error
      Condition="!Exists('$(KaleManagedDir)\Assembly-CSharp.dll')"
      Text="KaleGameDir must point at the folder holding MasterHealerKale.exe. Looked for $(KaleManagedDir)\Assembly-CSharp.dll." />
  </Target>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
    <ProjectReference Include="../IdleWarden.Bridge/IdleWarden.Bridge.csproj" />
    <ProjectReference Include="../IdleWarden.Kale.Decisions/IdleWarden.Kale.Decisions.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseInstalledGame)' != 'true'">
    <!-- `Private=false` keeps the stub out of the output folder. Shipping an
         assembly called Assembly-CSharp next to the mod would shadow the game's
         own, and every call would throw. -->
    <ProjectReference Include="../IdleWarden.Kale.GameStubs/IdleWarden.Kale.GameStubs.csproj" Private="false" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseInstalledGame)' == 'true'">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(KaleManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(KaleManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KaleManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
