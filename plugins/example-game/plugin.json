{
  "$schema": "https://idlewarden.github.io/registry/schema/plugin-manifest.schema.json",
  "id": "dev.idlewarden.example-game",
  "name": "Example Game",
  "version": "26.9.4",
  "api_version": "^0.1",
  "game": {
    "executable": "ExampleGame.exe",
    "window_title": "Example Game",
    "title": "Example Game",
    "tested_versions": [
      {
        "version": "0.0.0-stub",
        "status": "partial",
        "tested_on": "2026-08-25",
        "notes": "Reference plugin. Nothing is verified against a real game yet."
      }
    ]
  },
  "multiplayer": false,
  "presentation": {
    "description": "A tier-1 declarative plugin, written to be copied. No code.",
    "tags": [
      "reference",
      "template"
    ]
  },
  "rights": {
    "license": "Apache-2.0",
    "authors": [
      "The IdleWarden contributors"
    ],
    "asset_provenance": "hashes-only",
    "trademark_notice": "Fictional game. No third-party trademarks involved."
  },
  "hot_reload": {
    "rules": true,
    "assets": true,
    "profiles": true,
    "presentation": true
  },
  "signals": [
    {
      "id": "ui.screen_id",
      "value_type": "enum",
      "description": "Which screen is currently shown."
    },
    {
      "id": "resource.gold",
      "value_type": "int",
      "description": "Gold counter.",
      "unit": "gold"
    },
    {
      "id": "upgrade.affordable",
      "value_type": "bool",
      "description": "Is the next upgrade buyable."
    },
    {
      "id": "progress.bar",
      "value_type": "ratio",
      "description": "Main progress bar, 0..1."
    }
  ],
  "intents": [
    "collect_reward",
    "buy_upgrade",
    "dismiss_popup"
  ],
  "capabilities": [
    "capture",
    "input.mouse"
  ]
}
