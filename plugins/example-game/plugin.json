{
  "id": "dev.idlewarden.example-game",
  "name": "Example Game",
  "version": "0.1.0",
  "api_version": "^0.1",
  "authors": ["The IdleWarden contributors"],
  "description": "A tier-1 declarative plugin, written to be copied. No code.",
  "license": "Apache-2.0",
  "game": {
    "executable": "ExampleGame.exe",
    "window_title": "Example Game"
  },
  "multiplayer": false,
  "signals": [
    { "id": "ui.screen_id",       "value_type": "enum",  "description": "Which screen is currently shown." },
    { "id": "resource.gold",      "value_type": "int",   "description": "Gold counter.", "unit": "gold" },
    { "id": "upgrade.affordable", "value_type": "bool",  "description": "Is the next upgrade buyable." },
    { "id": "progress.bar",       "value_type": "ratio", "description": "Main progress bar, 0..1." }
  ],
  "intents": ["collect_reward", "buy_upgrade", "dismiss_popup"],
  "capabilities": [
    { "kind": "capture" },
    { "kind": "input_mouse" }
  ]
}
