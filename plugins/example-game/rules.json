{
  "$comment": "How signals are extracted, and what to do about them. All coordinates are window-relative, 0.0..=1.0, never screen pixels (ADR-0003). Conditions are structured rather than written as expressions, so a schema can validate them and the region editor can round-trip them without parsing text.",

  "anchors": [
    {
      "name": "top_bar_logo",
      "search_area": { "x": 0.0, "y": 0.0, "w": 0.3, "h": 0.12 },
      "template": "assets/logo.png",
      "min_score": 0.85
    }
  ],

  "signals": [
    {
      "id": "ui.screen_id",
      "extractor": {
        "method": "template_match",
        "roi": { "x": 0.0, "y": 0.0, "w": 1.0, "h": 0.15 },
        "template": "assets/header_main.png",
        "min_score": 0.8
      }
    },
    {
      "id": "ui.reward_ready",
      "extractor": {
        "method": "color_probe",
        "roi": { "x": 0.49, "y": 0.71, "w": 0.02, "h": 0.02 },
        "rgb": [232, 185, 62],
        "tolerance": 24
      }
    },
    {
      "id": "upgrade.affordable",
      "extractor": {
        "method": "color_probe",
        "roi": { "x": 0.8, "y": 0.6, "w": 0.02, "h": 0.02 },
        "rgb": [64, 200, 96],
        "tolerance": 24
      }
    }
  ],

  "intents": [
    {
      "$comment": "Declaration order is priority: the first intent whose conditions hold wins.",
      "name": "collect_reward",
      "when": [
        { "op": "is_true", "signal": "ui.screen_id" },
        { "op": "is_true", "signal": "ui.reward_ready" }
      ],
      "commands": [
        { "op": "click", "at": { "x": 0.5, "y": 0.72 }, "button": "left" },
        { "op": "wait", "ms": 300 }
      ],
      "$comment2": "An intent without a post-condition is refused at load (ADR-0003).",
      "post_condition": [{ "op": "is_false", "signal": "ui.reward_ready" }],
      "min_confidence": 0.8
    },
    {
      "name": "buy_upgrade",
      "when": [{ "op": "is_true", "signal": "upgrade.affordable" }],
      "commands": [
        { "op": "click", "at": { "x": 0.81, "y": 0.61 }, "button": "left" },
        { "op": "wait", "ms": 250 }
      ],
      "post_condition": [{ "op": "is_false", "signal": "upgrade.affordable" }],
      "min_confidence": 0.8
    }
  ]
}
